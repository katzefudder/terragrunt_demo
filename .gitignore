# Terraform working directory
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs and debug output
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
*.plan

# Variable files containing sensitive or local values
*.tfvars
*.tfvars.json

# Terragrunt cache and generated files
.terragrunt-cache/
**/.terragrunt-cache/*

# Terragrunt log file
terragrunt-debug.tfvars

# macOS
.DS_Store
